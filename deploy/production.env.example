COMPOSE_PROJECT_NAME=casa-automacao
CASA_TAG=latest

APP_SOURCE_DIR=/var/www/casa-automacao
MQTT_CONFIG_DIR=./mosquitto/config

TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt
API_DOMAIN=casa-api.matheusqueiroz.dev.br
MQTT_DOMAIN=casa-mqtt.matheusqueiroz.dev.br

DATABASE_URL='postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/casa_automacao?sslmode=require'
DB_MAX_CONNECTIONS=5

MQTT_API_USERNAME=api-casa
MQTT_API_PASSWORD='GERE_UMA_SENHA_FORTE'

BETTER_AUTH_SECRET='GERE_UMA_CHAVE_ALEATORIA_COM_PELO_MENOS_32_CARACTERES'
BETTER_AUTH_URL=https://casa-api.matheusqueiroz.dev.br
AUTH_TRUSTED_ORIGINS='https://casa-api.matheusqueiroz.dev.br,casaautomacao://,exp://,exp://**,exp://192.168.*.*:*/**'
