{
  "name": "casa-automacao",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "predev": "npm run infra:up",
    "dev": "turbo run dev",
    "predev:api": "npm run infra:up",
    "dev:api": "turbo run dev --filter=@casa/api",
    "dev:app": "turbo run dev --filter=@casa/app",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check": "turbo run lint typecheck test build",
    "infra:up": "docker compose -f deploy/docker-compose.local.yml --env-file deploy/.env up -d postgres mqtt",
    "infra:down": "docker compose -f deploy/docker-compose.local.yml --env-file deploy/.env down"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "turbo": "^2.6.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.13"
  }
}
